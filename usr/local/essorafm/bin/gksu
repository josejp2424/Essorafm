#!/usr/bin/env python3
# gksu (Essora) - versión corregida sin sudo -E
#
# CAMBIO IMPORTANTE respecto a la versión anterior:
# La versión anterior usaba `sudo -S -E` (preserve environment), pero en
# sistemas con sudoers que tienen `Defaults env_reset` y no incluyen al
# usuario en `Defaults!env_keep`, el flag -E hace que sudo rechace el
# comando con "sorry, you are not allowed to preserve the environment".
#
# Ahora pasamos solo las envvars necesarias (DISPLAY, XAUTHORITY, etc.)
# vía la opción --preserve-env=VAR de sudo, que es más restrictiva y la
# mayoría de los sudoers permiten. Para comandos no-GUI (rm, cp, mv) ni
# siquiera hace falta pasar entorno.
#
# Modos:
#   gksu comando ...           Modo detach (default, no espera)
#   gksu --wait comando ...    Espera a que el comando termine
#
# Pide contraseña (GTK3), valida con sudo, lanza el comando como root.

import os
import sys
import subprocess
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk


class PasswordDialog(Gtk.Window):
    def __init__(self, title, text, pass_label):
        super().__init__(title=title)

        self.set_decorated(False)
        self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_default_size(380, 200)
        self.connect("delete-event", self.on_cancel)

        main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(main)

        header = Gtk.HeaderBar()
        header.set_show_close_button(False)
        header.set_decoration_layout(":")
        header.set_title(title)

        # icono como el yad
        icon_path = "/usr/share/pixmaps/gksu.svg"
        if os.path.exists(icon_path):
            img = Gtk.Image.new_from_file(icon_path)
            img.set_pixel_size(18)
            header.pack_start(img)

        main.pack_start(header, False, False, 0)
        main.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 0)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_margin_top(20)
        box.set_margin_bottom(20)
        box.set_margin_start(30)
        box.set_margin_end(30)
        main.pack_start(box, True, True, 0)

        lbl = Gtk.Label()
        # Usar set_markup pero con tags que GTK entiende. '<br>' no es
        # válido en Pango markup — uso \n directamente en el texto.
        lbl.set_markup(text.replace("<br/>", "\n").replace("<br>", "\n").replace("</br>", ""))
        lbl.set_line_wrap(True)
        lbl.set_justify(Gtk.Justification.CENTER)
        box.pack_start(lbl, False, False, 0)

        pl = Gtk.Label(label=pass_label)
        pl.set_xalign(0)
        box.pack_start(pl, False, False, 0)

        self.entry = Gtk.Entry()
        self.entry.set_visibility(False)
        self.entry.set_invisible_char("●")
        self.entry.set_activates_default(True)
        box.pack_start(self.entry, False, False, 0)

        self.error_lbl = Gtk.Label()
        self.error_lbl.set_xalign(0)
        self.error_lbl.get_style_context().add_class("error")
        box.pack_start(self.error_lbl, False, False, 0)

        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        btn_box.set_halign(Gtk.Align.END)
        box.pack_end(btn_box, False, False, 0)

        cancel_btn = Gtk.Button.new_with_mnemonic("_" + texts(get_lang())["cancel"])
        cancel_btn.connect("clicked", self.on_cancel)
        btn_box.pack_start(cancel_btn, False, False, 0)

        ok_btn = Gtk.Button.new_with_mnemonic("_" + texts(get_lang())["ok"])
        ok_btn.get_style_context().add_class("suggested-action")
        ok_btn.set_can_default(True)
        ok_btn.connect("clicked", self.on_ok)
        btn_box.pack_start(ok_btn, False, False, 0)
        ok_btn.grab_default()

        self.password = None
        self.cancelled = False

        self.show_all()
        self.entry.grab_focus()

    def show_error(self, message):
        self.error_lbl.set_text(message)
        self.entry.set_text("")
        self.entry.grab_focus()

    def on_ok(self, *_):
        self.password = self.entry.get_text()
        Gtk.main_quit()

    def on_cancel(self, *_):
        self.cancelled = True
        Gtk.main_quit()
        return True


def get_lang():
    return (os.environ.get("LC_ALL") or os.environ.get("LANG") or "en")[:2].lower()


def texts(lang):
    user = os.environ.get("USER") or os.environ.get("LOGNAME") or "user"
    tr = {
        "es": {"title":"Autenticación","text":f"Se requiere autenticación\npara el usuario: <b>{user}</b>",
               "pass_label":"Contraseña:","wrong":"Contraseña incorrecta, intente de nuevo","cancel":"Cancelar","ok":"Autenticar"},
        "ca": {"title":"Autenticació","text":f"Cal autenticació\nper a l'usuari: <b>{user}</b>",
               "pass_label":"Contrasenya:","wrong":"Contrasenya incorrecta, torna-ho a provar","cancel":"Cancel·la","ok":"Autentica"},
        "de": {"title":"Authentifizierung","text":f"Authentifizierung erforderlich\nfür den Benutzer: <b>{user}</b>",
               "pass_label":"Passwort:","wrong":"Falsches Passwort, erneut versuchen","cancel":"Abbrechen","ok":"Authentifizieren"},
        "fr": {"title":"Authentification","text":f"Authentification requise\npour l'utilisateur: <b>{user}</b>",
               "pass_label":"Mot de passe:","wrong":"Mot de passe incorrect, veuillez réessayer","cancel":"Annuler","ok":"Authentifier"},
        "it": {"title":"Autenticazione","text":f"Autenticazione richiesta\nper l'utente: <b>{user}</b>",
               "pass_label":"Password:","wrong":"Password errata, riprovare","cancel":"Annulla","ok":"Autentica"},
        "hu": {"title":"Hitelesítés","text":f"Hitelesítés szükséges\na felhasználó számára: <b>{user}</b>",
               "pass_label":"Jelszó:","wrong":"Hibás jelszó, próbálja újra","cancel":"Mégse","ok":"Hitelesítés"},
        "ja": {"title":"認証","text":f"ユーザーの認証が必要です: <b>{user}</b>",
               "pass_label":"パスワード:","wrong":"パスワードが間違っています。再試行してください","cancel":"キャンセル","ok":"認証"},
        "ru": {"title":"Аутентификация","text":f"Требуется аутентификация\nдля пользователя: <b>{user}</b>",
               "pass_label":"Пароль:","wrong":"Неверный пароль, попробуйте снова","cancel":"Отмена","ok":"Аутентификация"},
        "zh": {"title":"身份验证","text":f"需要身份验证\n对于用户: <b>{user}</b>",
               "pass_label":"密码:","wrong":"密码错误，请重试","cancel":"取消","ok":"验证"},
        "pt": {"title":"Autenticação","text":f"É necessária autenticação\npara o usuário: <b>{user}</b>",
               "pass_label":"Senha:","wrong":"Senha incorreta, tente novamente","cancel":"Cancelar","ok":"OK"},
        "en": {"title":"Authentication","text":f"Authentication needed for user: <b>{user}</b>",
               "pass_label":"Password:","wrong":"Wrong password, retry","cancel":"Cancel","ok":"Authenticate"},
    }

    for k in tr:
        if lang.startswith(k):
            return tr[k]
    return tr["en"]


def sudo_check(password: str) -> bool:
    """Verifica la contraseña con sudo sin ejecutar nada.
    -k fuerza a pedir password (no usa cache)
    -S lee password de stdin
    -v valida la sesión sudo
    No usamos -E acá porque solo estamos validando.
    """
    p = subprocess.run(
        ["sudo", "-S", "-k", "-v"],
        input=(password + "\n").encode("utf-8"),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return p.returncode == 0


def _build_sudo_cmd(cmd):
    """Construye el comando sudo evitando -E.

    En lugar de preservar TODO el entorno (-E, que muchos sudoers
    rechazan), pasamos las variables que típicamente necesitan las apps
    gráficas: DISPLAY, XAUTHORITY, DBUS_SESSION_BUS_ADDRESS,
    XDG_RUNTIME_DIR, XDG_DATA_DIRS, XDG_CONFIG_DIRS, HOME.

    Para comandos no-GUI (rm, cp, mv, mkdir, chmod, chown) ni siquiera
    hacen falta esas envvars, pero pasarlas no rompe.
    """
    preserve = [
        "DISPLAY", "XAUTHORITY", "DBUS_SESSION_BUS_ADDRESS",
        "XDG_RUNTIME_DIR", "XDG_DATA_DIRS", "XDG_CONFIG_DIRS",
        "LANG", "LC_ALL",
    ]
    env_args = []
    for var in preserve:
        val = os.environ.get(var)
        if val:
            env_args.append(f"{var}={val}")

    # sudo -S -- lee pass de stdin
    # env VAR1=val1 VAR2=val2 ... cmd ...
    return ["sudo", "-S", "--", "env"] + env_args + list(cmd)


def sudo_run_detach(password: str, cmd: list) -> int:
    """Lanza el comando en background y devuelve inmediatamente."""
    p = subprocess.Popen(
        _build_sudo_cmd(cmd),
        stdin=subprocess.PIPE,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True,
    )
    p.stdin.write((password + "\n").encode("utf-8"))
    p.stdin.flush()
    p.stdin.close()
    return 0


def sudo_run_wait(password: str, cmd: list) -> int:
    """Lanza el comando y espera a que termine. Devuelve su exit code."""
    p = subprocess.run(
        _build_sudo_cmd(cmd),
        input=(password + "\n").encode("utf-8"),
    )
    return p.returncode


def main():
    if len(sys.argv) < 2:
        print("Uso: gksu [--wait] comando [args...]", file=sys.stderr)
        sys.exit(2)

    wait_mode = False
    argv = sys.argv[1:]
    if argv[0] == "--wait":
        wait_mode = True
        argv = argv[1:]
    if not argv:
        print("Uso: gksu [--wait] comando [args...]", file=sys.stderr)
        sys.exit(2)

    lang = get_lang()
    t = texts(lang)

    # CSS minimal para evitar errores de tema externo
    css = b"""
    .error { color: #d04040; }
    """
    try:
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )
    except Exception:
        pass

    while True:
        dlg = PasswordDialog(t["title"], t["text"], t["pass_label"])
        Gtk.main()
        if dlg.cancelled or dlg.password is None:
            dlg.destroy()
            sys.exit(126)  # 126 = autenticación cancelada
        password = dlg.password
        dlg.destroy()

        # Procesar eventos pendientes para que se cierre la ventana antes
        # de invocar sudo (sin esto, la ventana queda visible mientras
        # sudo corre).
        while Gtk.events_pending():
            Gtk.main_iteration()

        if sudo_check(password):
            break
        # Pass incorrecta: mostramos otro diálogo con el error
        # (instanciamos uno nuevo porque el anterior ya se destruyó)
        err_dlg = PasswordDialog(t["title"], t["text"] + "\n\n<b>" + t["wrong"] + "</b>", t["pass_label"])
        Gtk.main()
        if err_dlg.cancelled or err_dlg.password is None:
            err_dlg.destroy()
            sys.exit(126)
        password = err_dlg.password
        err_dlg.destroy()
        while Gtk.events_pending():
            Gtk.main_iteration()
        if sudo_check(password):
            break

    if wait_mode:
        rc = sudo_run_wait(password, argv)
        sys.exit(rc)
    else:
        sudo_run_detach(password, argv)
        sys.exit(0)


if __name__ == "__main__":
    main()
